# ── Required in production ──
APP_SECRET=change-me-to-a-long-random-string   # encrypts stored API keys + signs admin sessions
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me                       # or ADMIN_PASSWORD_HASH=<bcrypt hash>
# COOKIE_SECURE=true                           # when served over HTTPS

# ── Optional: keys can also be added later in /admin (stored encrypted, never public) ──
# META_ONLY defaults to on. While it is on, only Meta models run (Muse, SAM, Baseten Muse Spark Open,
# self-hosted MMS-TTS and wav2vec2). The keys below are ignored until an admin turns META_ONLY off.
META_API_KEY=
# META_BASE_URL=https://api.meta.ai/v1
# META_ONLY=on
# MMS_TTS_URL=http://tts:8000
GEMINI_API_KEY=          # ignored while META_ONLY=on (Veo is not a Meta model)
ELEVENLABS_API_KEY=      # ignored while META_ONLY=on
XAI_API_KEY=             # ignored while META_ONLY=on
YOUTUBE_API_KEY=

# ── Runtime ──
DATA_DIR=./data
# CHROMIUM_PATH=/path/to/chrome   # for the research desktop if Playwright's browser is elsewhere
